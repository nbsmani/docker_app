# Dockerfile.spark — BALU ULTRA-SLIM
FROM python:3.9-alpine as builder

# Install Java
RUN apk add --no-cache openjdk17-jre

# Download Spark (cached in context)
COPY spark-3.5.0-bin-hadoop3.tgz /tmp/
RUN tar xzf /tmp/spark-3.5.0-bin-hadoop3.tgz -C /opt/ && \
    mv /opt/spark-3.5.0-bin-hadoop3 /opt/spark && \
    rm /tmp/spark-3.5.0-bin-hadoop3.tgz

FROM python:3.9-alpine

# Copy Java + Spark
COPY --from=builder /usr/lib/jvm/java-17-openjdk /usr/lib/jvm/java-17-openjdk
COPY --from=builder /opt/spark /opt/spark

# Set env
ENV JAVA_HOME=/usr/lib/jvm/java-17-openjdk
ENV SPARK_HOME=/opt/spark
ENV PATH=$SPARK_HOME/bin:$SPARK_HOME/sbin:$PATH
ENV PYTHONPATH=$SPARK_HOME/python:$SPARK_HOME/python/lib/py4j-*.zip:$PYTHONPATH

# Install PySpark (for Python API)
RUN pip install --no-cache-dir pyspark==3.5.0 pandas sqlalchemy psycopg2-binary

# User
RUN adduser -D spark
USER spark
WORKDIR /home/spark